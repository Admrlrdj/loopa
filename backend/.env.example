# Salin ke .env (jangan di-commit)
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000

# Inferensi: "mock" (default, tanpa model) atau "yolo" (butuh requirements-ml.txt + best.pt)
INFERENCE_BACKEND=mock
MODEL_PATH=../models/best.pt
# Hanya untuk mock: normal | drowsy
MOCK_SCENARIO=normal

# Hanya untuk yolo (path relatif dihitung dari folder backend/)
YOLO_CONF=0.25
YOLO_IMGSZ=640
YOLO_DEVICE=
# Jika nama kelas di data.yaml berbeda, petakan (JSON). Contoh: {"closed_eye":"eye_closed"}
YOLO_LABEL_ALIASES={}

# Threshold SEMENTARA - kalibrasi dari uji webcam (PRD 17), jangan dianggap final
EYE_CLOSURE_SECONDS=1.5
ALERT1_CONFIRM_SECONDS=3.0
ALERT2_RECHECK_SECONDS=5.0
ALERT_COOLDOWN_SECONDS=30.0

# Supabase (tahap 10-11 Nov)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Alat kumpul data webcam (halaman /collect). Aktifkan HANYA saat mengumpulkan data secara lokal.
ENABLE_DETECT=false

# Auth (Supabase JWT). SUPABASE_URL cukup untuk proyek baru (JWKS); SUPABASE_JWT_SECRET hanya untuk proyek lama (HS256).
SUPABASE_JWT_SECRET=
AUTH_REQUIRED=false

# LLM insight + tip Break (OpenRouter, model DeepSeek gratis). Key dari https://openrouter.ai/keys, jangan di-commit.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat-v3-0324:free
LLM_TIMEOUT_SECONDS=20
LLM_TOTAL_SECONDS=45
# Model cadangan bila model utama kena rate limit (dipisah koma), mis. deepseek/deepseek-chat-v3-0324
LLM_FALLBACK_MODELS=
